# Copy to `.env` (repo root) before `docker compose up`.
# docker compose reads `.env` from the directory the compose file lives in.

# Sourcegraph token — required for C++ discovery at depth > 0.
SG_TOKEN=

# GitHub token — used to enrich repos with stars/commits/license/README.
GH_TOKEN=

# Contact email sent as the User-Agent to Crossref/OpenAlex etc.
AUDIT_EMAIL=audit-bot@example.com

# OpenAlex premium API key (authenticated lane). Strongly recommended: it is the
# single biggest relief for OpenAlex rate limiting on citation lookups. A job's
# payload may override this; left here it is the worker-wide default.
OPENALEX_API_KEY=

# Optional OpenAlex knobs (per-job payload may override; these are defaults):
# throttle valve (seconds before each OpenAlex request; 0 = off with a key), and
# the max dependency-graph depth at which paper/citation analysis runs
# (1 = root project + direct consumers only; deeper nodes skip OpenAlex).
OPENALEX_DELAY=0
CITATION_GRAPH_DEPTH=1

# Host port nginx publishes on (the web UI and the API).
HTTP_PORT=8080

# --- Web tier (fast: submit / serve results / stream progress) ---
WEB_CONCURRENCY=2      # gunicorn worker processes
WEB_THREADS=16         # threads per worker; each open live-progress stream holds one
SSE_MAX_STREAMS=12     # live-progress streams per process (keep < WEB_THREADS)
SSE_MAX_SECONDS=60     # a stream's lifetime before the browser transparently resumes
GUNICORN_TIMEOUT=120
ALLOW_PAYLOAD_TOKENS=1 # accept sg_token/gh_token in requests; set 0 in production

# --- Worker tier (runs the crawls) ---
WORKER_CONCURRENCY=2   # max audits running at once
AUDIT_TIMEOUT=3600     # per-audit hard limit (s) — raise for very deep crawls
POLL_INTERVAL=2.0      # seconds between queue scans
JOB_TTL=0              # auto-delete finished jobs older than N seconds (0=keep)
STALE_AFTER=300        # fail a running job whose worker stopped heart-beating (s)

# Optional: OpenAI-compatible endpoint used as a paper-relevance tie-breaker.
RELEVANCE_LLM_URL=
RELEVANCE_LLM_MODEL=local-model
RELEVANCE_LLM_TOKEN=

LOG_LEVEL=info
