# Copy to `.env` (repo root) before `docker compose up`.
# docker compose reads `.env` from the directory the compose file lives in.

# Sourcegraph token — required for C++ discovery at depth > 0.
SG_TOKEN=

# GitHub token — used to enrich repos with stars/commits/license/README.
GH_TOKEN=

# Contact email sent as the User-Agent to Crossref/OpenAlex etc.
AUDIT_EMAIL=audit-bot@example.com

# Host port nginx publishes on.
HTTP_PORT=8080

# --- Web tier (fast: submit / poll / serve results) ---
WEB_CONCURRENCY=2      # gunicorn worker processes
WEB_THREADS=4          # threads per worker
GUNICORN_TIMEOUT=120

# --- Worker tier (runs the crawls) ---
WORKER_CONCURRENCY=2   # max audits running at once
AUDIT_TIMEOUT=3600     # per-audit hard limit (s) — raise for very deep crawls
POLL_INTERVAL=2.0      # seconds between queue scans
JOB_TTL=0              # auto-delete finished jobs older than N seconds (0=keep)

LOG_LEVEL=info
