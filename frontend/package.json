{
  "name": "dependent-audit-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:types": "json2ts -i ../udg_schema.json -o src/api/udg.generated.ts --bannerComment \"/* Generated from udg_schema.json by json-schema-to-typescript. Do not edit; run npm run gen:types. */\""
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.0",
    "cytoscape": "^3.34.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.12.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
